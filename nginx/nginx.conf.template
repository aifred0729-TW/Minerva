worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;

    # Increase buffer sizes for large headers (JWTs)
    proxy_buffer_size 16k;
    proxy_buffers 4 16k;
    large_client_header_buffers 4 16k;

    # Increase max body size for file uploads
    client_max_body_size 50m;

    server {
        listen 443 ssl;

        ssl_certificate     /etc/nginx/ssl/minerva.crt;
        ssl_certificate_key /etc/nginx/ssl/minerva.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        # Root redirect to Minerva login
        location = / {
            return 302 /new/login;
        }

        # Serve Minerva static files
        location /new/ {
            alias /usr/share/nginx/html/new/;
            try_files $uri $uri/ /new/index.html;
        }

        # GraphQL - HTTP and WebSocket
        location /graphql/ {
            proxy_pass ${MYTHIC_ADDRESS}/graphql/;
            proxy_ssl_verify off;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Long timeouts for WebSocket connections
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # Auth endpoint
        location /auth {
            proxy_pass ${MYTHIC_ADDRESS}/auth;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Token refresh endpoint
        location /refresh {
            proxy_pass ${MYTHIC_ADDRESS}/refresh;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # MSF-RPC proxy — forward to msfrpcd on host
        location /msf-rpc/ {
            proxy_pass http://host.docker.internal:55553/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # Direct download endpoint
        location /direct/ {
            proxy_pass ${MYTHIC_ADDRESS}/direct/;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
