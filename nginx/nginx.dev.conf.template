worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;

    # Increase buffer sizes for large headers (JWTs)
    proxy_buffer_size 16k;
    proxy_buffers 4 16k;
    large_client_header_buffers 4 16k;

    # Increase max body size for file uploads
    client_max_body_size 50m;

    server {
        listen 443 ssl;

        ssl_certificate     /etc/nginx/ssl/minerva.crt;
        ssl_certificate_key /etc/nginx/ssl/minerva.key;
        ssl_protocols       TLSv1.2 TLSv1.3;

        # Root redirect to Minerva login
        # Machine name of the host running Minerva, readable WITHOUT auth so the
        # login screen can show which server it is pointed at.
        #
        # Served from a mounted file rather than substituted into this config.
        # envsubst runs in the entrypoint, which is baked into the image, so a
        # new variable here would need a rebuild to take effect — and silently
        # crash-loop nginx until someone did one. A mounted file needs neither.
        #
        # nginx's own $hostname is not usable: inside a container it is the
        # container ID, which would be actively misleading rather than merely
        # unknown. A missing file 404s and the client falls back to the URL host.
        location = /server-info {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            alias /usr/share/nginx/runtime/server-info.json;
        }

        location = / {
            return 302 /new/login;
        }

        # Dev server proxy — hot reload
        location /new/ {
            proxy_pass http://minerva-dev:3000/new/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # WebSocket for hot reload (webpack dev server)
        location /ws {
            proxy_pass http://minerva-dev:3000/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # GraphQL - HTTP and WebSocket
        location /graphql/ {
            proxy_pass ${MYTHIC_ADDRESS}/graphql/;
            proxy_ssl_verify off;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # Mythic REST/webhook API — task_upload_file_webhook, eventing_import_webhook,
        # files/download/*, /api/v1.0/health, etc. All client calls under /api/* go
        # straight to mythic_server. Buffering is disabled so multi-megabyte file
        # uploads stream through without spooling to disk inside this proxy.
        location /api/ {
            proxy_pass ${MYTHIC_ADDRESS}/api/;
            proxy_ssl_verify off;

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_request_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        # Auth endpoint
        location /auth {
            proxy_pass ${MYTHIC_ADDRESS}/auth;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Invite registration endpoint
        location /invite {
            proxy_pass ${MYTHIC_ADDRESS}/invite;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Token refresh endpoint
        location /refresh {
            proxy_pass ${MYTHIC_ADDRESS}/refresh;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }


        # ── Authorization gate for /msf-rpc/ ────────────────────────────────
        # Mythic's `GET /me` sits behind JwtAuthMiddleware(), so it answers 200
        # for a valid operator JWT and 401 otherwise. nginx forwards the client's
        # request headers (including Authorization) into this subrequest, which
        # turns it into a general-purpose "is this caller a logged-in operator?"
        # check. Body is dropped: /me is a GET and auth_request must not consume
        # the msgpack payload destined for msfrpcd.
        # Deployment-generated msfrpcd credential, readable only by an
        # authenticated operator. Replaces the password that used to be a literal
        # in docker-compose.metasploit.yml AND compiled into the served JS bundle.
        location = /msf-config {
            auth_request /_msf_authz;
            default_type application/json;
            add_header Cache-Control "no-store" always;
            alias /usr/share/nginx/runtime/msf-config.json;
        }

        location = /_msf_authz {
            internal;
            proxy_pass ${MYTHIC_ADDRESS}/me;
            proxy_ssl_verify off;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $host;
            proxy_set_header X-Original-URI $request_uri;
        }

        # MSF-RPC proxy — msgpack RPC to msfrpcd, for authenticated operators only.
        #
        # This used to be an unauthenticated passthrough on the same public 443 as
        # the login page, in front of an msfrpcd that shipped a default password.
        # Anyone who could route to this host could call module.execute and
        # session.shell_write. auth_request now requires a valid Mythic operator
        # JWT before the request ever reaches Metasploit.
        location /msf-rpc/ {
            auth_request /_msf_authz;

            # Container-network hop: msfrpcd no longer listens on the host
            # gateway address, only on loopback + this docker network.
            proxy_pass http://minerva_msf:55553/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # Direct download endpoint
        location /direct/ {
            proxy_pass ${MYTHIC_ADDRESS}/direct/;
            proxy_ssl_verify off;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
