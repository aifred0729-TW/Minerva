{
  "name": "minerva-desktop",
  "productName": "Minerva",
  "version": "2.2.1",
  "private": true,
  "description": "Minerva C2 Interface \u2014 desktop console for Mythic (Windows / macOS)",
  "license": "AGPL-3.0",
  "main": "src/main.js",
  "scripts": {
    "prepare-bundle": "node scripts/prepare-bundle.js",
    "start": "npm run prepare-bundle && electron .",
    "dist": "npm run prepare-bundle && electron-builder",
    "dist:win": "npm run prepare-bundle && electron-builder --win",
    "dist:mac": "npm run prepare-bundle && electron-builder --mac",
    "dist:all": "npm run prepare-bundle && electron-builder --win --mac",
    "icons": "python3 build/make-icons.py"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aifred0729-TW/Minerva.git"
  },
  "author": "Minerva"
}
