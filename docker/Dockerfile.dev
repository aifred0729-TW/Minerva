FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

# Source code will be mounted as a volume — not copied
# This enables hot reload via react-scripts dev server

EXPOSE 3000

ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
# Fast Refresh injects react-refresh + its webpack plugin into the bundle that
# real operators download. This deployment serves the dev server as production,
# so that instrumentation is pure cost here.
ENV FAST_REFRESH=false
ENV WDS_POLLING=true
ENV WDS_SOCKET_PATH=ws
ENV WDS_SOCKET_PORT=443

CMD ["npm", "run", "react-start"]
