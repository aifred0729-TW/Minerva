# Stage 1: Build the React application
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

COPY . .
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

RUN apk add --no-cache openssl

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy build output to nginx html directory under /new/
COPY --from=build /app/build /usr/share/nginx/html/new

# Copy nginx config template and entrypoint
COPY nginx/nginx.conf.template /etc/nginx/templates/nginx.conf.template
COPY nginx/docker-entrypoint.sh /docker-entrypoint-minerva.sh
RUN chmod +x /docker-entrypoint-minerva.sh

EXPOSE 443

ENTRYPOINT ["/docker-entrypoint-minerva.sh"]
CMD ["nginx", "-g", "daemon off;"]
